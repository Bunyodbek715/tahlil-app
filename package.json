{
  "name": "tahlil-app",
  "version": "1.0.0",
  "description": "Tahlil ilovasi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uz.tahlil.app",
    "productName": "Tahlil",
    "files": ["main.js", "www/**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
